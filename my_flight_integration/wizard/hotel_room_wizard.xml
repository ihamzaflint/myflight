<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_room_wizard_form" model="ir.ui.view">
        <field name="name">hotel.room.wizard.form</field>
        <field name="model">hotel.room.wizard</field>
        <field name="arch" type="xml">
            <form string="Hotel Room Details">
                <group>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="total_price" readonly="1"/>
                        <field name="total_tax" readonly="1"/>
                        <field name="amenities" readonly="1"/>
                    </group>
                    <group>
                        <field name="meal_type" readonly="1"/>
                    </group>

                    <group string="Cancellation Policy">
                        <field name="from_date" readonly="1"/>
                        <field name="charge_type" readonly="1"/>
                        <field name="cancellation_charge" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="desc" readonly="1" invisible="desc == False"/>
                        <field name="api_status" readonly="1"/>
                        <field name="raw_json_data" readonly="1" invisible="1"/>
                        <button type="object" name="action_add_guest_details" string="Add Guest Details" class="btn-primary" invisible="not_bookable"/>
                        <button type="object" name="action_book_room" string="Book" class="btn-primary" invisible="not_bookable"/>
                    </group>

                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
