<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--View to add rooms-->
    <record id="view_hotel_room_search_traveller_add_room_form" model="ir.ui.view">
        <field name="name">hotel.room.search.traveller.add.room.form</field>
        <field name="model">hotel.room.search</field>
        <field name="arch" type="xml">
            <form string="Add Rooms">
                <notebook>
                    <page name="traveller_line_ids" string="Room Details">
                        <field name="traveller_line_ids">
                            <list>
                                <field name="adults"/>
                                <field name="children"/>
                                <field name="children_ages"/>
                            </list>

                            <form>
                                <group>
                                    <field name="adults"/>
                                    <field name="children"/>
                                    <field name="children_ages" readonly="children == 0" placeholder="Age1, Age2......."/>
                                </group>
                            </form>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>


    <!-- View to add Guest Details in Room-->
    <record id="view_hotel_room_search_traveller_guest_details_form" model="ir.ui.view">
        <field name="name">hotel.room.search.traveller.guest.details.form</field>
        <field name="model">hotel.room.search</field>
        <field name="arch" type="xml">
            <form string="Add Rooms">
                <notebook>
                    <page name="traveller_line_ids" string="Room Details">
                        <field name="traveller_line_ids">
                            <list>
                                <field name="adults"/>
                                <field name="children"/>
                                <field name="children_ages"/>
                            </list>

                            <form>

                                <group>

                                    <group>
                                        <field name="adults" readonly="1"/>
                                        <field name="children" readonly="1"/>
                                        <field name="children_ages" readonly="children == 0" placeholder="Age1, Age2......."/>
                                    </group>

                                    <group>
                                        <field name="lead_email" required="1"/>
                                        <field name="lead_phone" required="1"/>
                                    </group>
                                </group>

                                <notebook>
                                    <page name="hotel_room_guest_detail_line_ids" string="Guest Details">
                                        <field name="hotel_room_guest_detail_line_ids">
                                            <list>
                                                <field name="title"/>
                                                <field name="partner_id"/>
                                                <field name="first_name"/>
                                                <field name="last_name"/>
                                                <field name="traveller_type"/>
                                            </list>

                                            <form>
                                                <group>
                                                    <group>
                                                        <field name="title" required="1"/>
                                                        <field name="partner_id" required="1"/>
                                                        <field name="first_name"/>
                                                        <field name="last_name"/>
                                                    </group>

                                                    <group>
                                                        <field name="dob" required="1"/>
                                                        <field name="traveller_type"/>
                                                    </group>
                                                </group>
                                            </form>
                                        </field>
                                    </page>
                                </notebook>
                            </form>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Save &amp; Return"
                            type="object"
                            name="action_return_prebook"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>

        </field>
    </record>



<!--    View to show detailed list of rooms-->
    <record id="view_hotel_room_more_options" model="ir.ui.view">
        <field name="name">hotel.room.search.more.options</field>
        <field name="model">hotel.room.search</field>
        <field name="arch" type="xml">
            <form string="More Room Options">
                <sheet>
                    <notebook>
                        <page name="variant_line_ids" string="Available Room Variants">
                            <field name="variant_line_ids" readonly="1">
                                <list string="Room Variants">
                                    <field name="name"/>
                                    <field name="meal_type"/>
                                    <field name="price"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="included" column_invisible="['|', ('included', '=', False), ('included', '=', '')]"/>
                                    <field name="refundable" column_invisible="['|', ('refundable', '=', False), ('refundable', '=', '')]"/>
                                    <field name="room_transfer" column_invisible="['|', ('room_transfer', '=', False), ('room_transfer', '=', '')]"/>
                                    <field name="booking_code" column_invisible="1"/>

                                    <button name="action_select_room" string="Select" type="object"
                                                    class="btn-primary"/>
                                </list>

                                <form string="Room Variant Details">
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="meal_type"/>
                                            <field name="price"/>
                                            <field name="included" invisible="included == False"/>
                                            <field name="refundable" invisible="refundable == False"/>
                                            <field name="room_transfer" invisible="room_transfer == False"/>
                                            <field name="booking_code" invisible="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


<!--Main room search view-->
    <record id="view_hotel_room_search_form" model="ir.ui.view">
        <field name="name">hotel.room.search.form</field>
        <field name="model">hotel.room.search</field>
        <field name="arch" type="xml">
            <form string="Hotel Search">
                <sheet>

                    <header>
                        <field name="state" widget="badge" invisible="state not in  ['confirmed', 'cancelled']"/>
                    </header>
                    <!-- 🔹 Search Filters Section -->
                    <group string="Search Filters" col="2">

                        <group>
                            <field name="check_in" required="1" readonly="state in ['confirmed', 'cancelled']"/>
                            <field name="check_out" required="1" readonly="state in ['confirmed', 'cancelled']"/>
                            <field name="country_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   required="1" readonly="state in ['confirmed', 'cancelled']"/>
                            <field name="city_id" required="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" readonly="state in ['confirmed', 'cancelled']"/>

                        </group>

                        <group>
                            <group>
                                <field name="guest_nationality_id" readonly="state in ['confirmed', 'cancelled']" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="traveller_line_ids" readonly="1" invisible="1"/>
                                <field name="total_adults"/>
                                <field name="total_children"/>
                                <field name="total_rooms"/>
                                <field name="hotel_detail_id" readonly="1" invisible="hotel_detail_id == False"/>
                            </group>

                            <group>
                                <button name="action_open_travellers"
                                    type="object"
                                    string="Room Details"
                                    class="btn-primary" invisible="state in ['confirmed', 'cancelled']"/>

                                <button type="object"
                                        name="action_search_hotel_rooms"
                                        string="Search"
                                        class="btn-primary" invisible="state in ['confirmed', 'cancelled']"/>
                            </group>


                        </group>

                        <group>
                            <field name="hotel_line_ids"
                                   widget="many2many_tags"
                                   required="0"
                                   string="Select Hotels"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   readonly="state in ['confirmed', 'cancelled']"
                            />
                        </group>
                    </group>

                    <!-- 🔹 Only show notebook after search -->
                    <notebook invisible="state in ['draft']">

                        <!-- 🔹 Search Result Page -->
                        <page string="Available Rooms">

                            <field name="line_ids"
                                   readonly="1"
                                   nolabel="1"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">

                                <list string="Rooms">
                                    <field name="hotel_id"/>
                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="meal_type"/>
                                    <field name="rating" column_invisible="['|', ('rating', '=', False), ('rating', '=', '')]"/>
                                    <field name="refundable" column_invisible="['|', ('refundable', '=', False), ('refundable', '=', '')]"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="booking_code" column_invisible="1"/>
                                    <field name="raw_json_data" column_invisible="1"/>
                                    <button name="action_view_more_rooms"
                                        string="View More Rooms"
                                        type="object"
                                        class="btn-primary"
                                        context="{'active_hotel_id': hotel_id}" invisible="parent.state == 'confirmed'"/>
                                </list>

                                <form string="Room Details">
                                    <sheet>
                                        <group>
                                            <field name="hotel_id"/>
                                            <field name="name"/>
                                            <field name="price"/>
                                            <field name="currency_id" invisible="1"/>
                                            <field name="meal_type"/>
                                            <field name="rating" invisible="rating == False"/>
                                            <field name="refundable" invisible="refundable == False"/>
                                            <field name="included" invisible="included == False"/>
                                            <field name="room_transfer" invisible="room_transfer == False"/>
                                            <field name="address" invisible="address == False"/>
                                            <field name="location" invisible="location == False"/>
                                        </group>

                                        <group>
                                            <field name="description" invisible="description == False"/>
                                        </group>

                                        <group string="Images &amp; Map" invisible="image == False and map_view == False">
                                            <field name="image" widget="html" invisible="image == False"/>
                                            <field name="map_view" widget="html" invisible="map_view == False"/>
                                        </group>
                                    </sheet>
                                </form>

                            </field>

                        </page>
                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="view_hotel_room_search_list" model="ir.ui.view">
        <field name="name">hotel.room.search.list</field>
        <field name="model">hotel.room.search</field>
        <field name="arch" type="xml">
            <list>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="country_id"/>
                <field name="total_adults"/>
                <field name="total_rooms"/>
                <field name="total_children"/>
            </list>
        </field>
    </record>

    <record id="action_hotel_room_search" model="ir.actions.act_window">
        <field name="name">Hotels</field>
        <field name="res_model">hotel.room.search</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('my_flight_integration.view_hotel_room_search_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('my_flight_integration.view_hotel_room_search_form')})
        ]"/>
    </record>


    <menuitem id="menu_booking_hotel_rooms" name="Hotel Rooms" parent="menu_hotel" action="action_hotel_room_search" sequence="2"/>
</odoo>