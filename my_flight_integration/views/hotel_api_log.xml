<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_api_log_form" model="ir.ui.view">
        <field name="name">hotel.api.log.form</field>
        <field name="model">hotel.api.log</field>
        <field name="arch" type="xml">
            <form string="Hotel API Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="endpoint"/>
                            <field name="method"/>
                            <field name="status_code"/>
                            <field name="is_success"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="create_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Request Payload">
                            <field name="request_payload" nolabel="1" widget="ace_editor"
                                   options="{'mode': 'json', 'readonly': true}"/>
                        </page>

                        <page string="Response Payload">
                            <field name="response_payload" nolabel="1" widget="ace_editor"
                                   options="{'mode': 'json', 'readonly': true}"/>
                        </page>

                        <page string="Error Message">
                            <field name="error_message" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_api_log_list" model="ir.ui.view">
        <field name="name">hotel.api.log.list</field>
        <field name="model">hotel.api.log</field>
        <field name="arch" type="xml">
            <list string="Hotel API Logs" create="false" edit="false">
                <field name="create_date"/>
                <field name="provider"/>
                <field name="endpoint"/>
                <field name="method"/>
                <field name="status_code"/>
                <field name="is_success"/>
                <field name="duration_ms"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>


    <record id="action_hotel_api_log" model="ir.actions.act_window">
        <field name="name">Hotel API Logs</field>
        <field name="res_model">hotel.api.log</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_hotel_api_log_root"
              name="Hotel API Logs"
              parent="menu_booking_conf_main"
              action="action_hotel_api_log"
              sequence="4"/>
</odoo>
