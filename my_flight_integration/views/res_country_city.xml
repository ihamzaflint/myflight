<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_country_city_form" model="ir.ui.view">
        <field name="name">res.country.city.form</field>
        <field name="model">res.country.city</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="country_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_country_city_list" model="ir.ui.view">
        <field name="name">res.country.city.list</field>
        <field name="model">res.country.city</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="action_res_country_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">res.country.city</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_res_country_city_list"/>
    </record>


    <menuitem id="menu_res_country_city_root"
              name="Cities"
              parent="menu_booking_conf_main"
              action="action_res_country_city" sequence="5"/>



</odoo>
