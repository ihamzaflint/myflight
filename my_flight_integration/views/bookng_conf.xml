<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_config_form" model="ir.ui.view">
        <field name="name">booking.conf.form</field>
        <field name="model">booking.conf</field>
        <field name="arch" type="xml">
            <form string="Booking Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <!-- CONFIGURATION -->
                        <page string="Configuration">
                            <field name="line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="url"/>
                                    <field name="username"/>
                                    <field name="password"/>
                                    <field name="access_token" readonly="1"/>
                                    <field name="company_id"/>
                                </list>

                                <form string="Configuration Line">
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="url"/>
                                            <field name="username"/>
                                            <field name="password" password="True"/>
                                        </group>
                                        <group>
                                            <field name="access_token" readonly="1"/>
                                            <field name="company_id"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_booking_config_tree" model="ir.ui.view">
        <field name="name">booking.conf.tree</field>
        <field name="model">booking.conf</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_booking_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">booking.conf</field>
        <field name="view_mode">list,form</field>
    </record>



    <menuitem id="menu_booking" name="Booking"/>
    <menuitem id="menu_booking_conf_main" name="Configurations" parent="menu_booking" sequence="3"/>
    <menuitem id="menu_booking_conf" name="Flight/hotels" action="action_booking_config" parent="menu_booking_conf_main" sequence="1"/>

</odoo>
