<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_booking_line_list" model="ir.ui.view">
        <field name="name">hotel.booking.line.list</field>
        <field name="model">hotel.booking.line</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="hotel_code"/>
                <field name="city_id"/>
                <field name="country_id"/>
                <field name="hotel_booking_id" column_invisible="1"/>
            </list>
        </field>
    </record>


    <record id="view_hotel_booking_line_form" model="ir.ui.view">
        <field name="name">hotel.booking.line.form</field>
        <field name="model">hotel.booking.line</field>
        <field name="arch" type="xml">
            <form sting="Hotel Details">
                <header>
                    <button name="action_fetch_details" type="object" string="Fetch Details" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="city_id" readonly="1"/>
                            <field name="country_id" options="{'no_open': True}" readonly="1"/>
                            <field name="address" readonly="1" invisible="address == False"/>
                            <field name="phone" readonly="1" invisible="phone == False"/>
                            <field name="fax" readonly="1" invisible="fax == False"/>
                            <field name="rating" readonly="1" invisible="rating == False"/>
                        </group>
                        <group>
                            <field name="description" widget="html" readonly="1" invisible="description == False"/>
                            <field name="attractions" readonly="1" invisible="attractions == False"/>
                            <field name="facilities" readonly="1" invisible="facilities == False"/>
                        </group>
                    </group>

                    <group string="Images" invisible="images_html == False">
                        <field name="images_html" invisible="images_html == False" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_hotel_booking_form" model="ir.ui.view">
        <field name="name">hotel.booking.form</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="country_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>

                    <button name="action_search_hotels" type="object" string="Search" class="btn btn-primary"/>

                    <notebook>
                        <page name="line_ids" string="Hotels">
                            <field name="line_ids"
                                   readonly="1"
                                   mode="list,form"
                                   context="{
                                        'list_view_ref': 'my_flight_custom.view_hotel_booking_line_list',
                                        'form_view_ref': 'my_flight_custom.view_hotel_booking_line_form'
                                    }"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_hotel_booking_list" model="ir.ui.view">
        <field name="name">hotel.booking.list</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="action_hotel" model="ir.actions.act_window">
        <field name="name">Hotels</field>
        <field name="res_model">hotel.booking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hotel_booking_list"/>
    </record>


    <menuitem id="menu_hotel" name="Hotel" parent="menu_booking" sequence="1"/>
    <menuitem id="menu_hotel_booking" name="Hotels" parent="menu_hotel" action="action_hotel" sequence="1"/>
</odoo>