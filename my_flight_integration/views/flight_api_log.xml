<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flight_api_log_form" model="ir.ui.view">
        <field name="name">view.flight.api.log.form</field>
        <field name="model">flight.api.log</field>
        <field name="arch" type="xml">
            <form string="Flight Logs">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="log_type" readonly="1"/>
                            <field name="type" readonly="1"/>
                            <field name="code" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="title" readonly="1"/>
                            <field name="request_payload" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_date" readonly="1"/>
                            <field name="url" readonly="1"/>
                            <field name="detail" readonly="1"/>
                            <field name="reference" readonly="1"/>
                            <field name="provider_id" readonly="1"/>
                            <field name="flight_search_id" readonly="1"/>
                            <field name="flight_search_line_id" readonly="1"/>
                            <field name="response_payload" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_flight_api_log_tree" model="ir.ui.view">
        <field name="name">view.flight.api.log.tree</field>
        <field name="model">flight.api.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="log_type"/>
                <field name="type"/>
                <field name="code"/>
                <field name="status"/>
                <field name="title"/>
                <field name="url"/>
                <!--                <field name="request_payload"/>-->
                <field name="detail"/>
                <field name="reference"/>
                <field name="provider_id"/>
                <field name="flight_search_id"/>
                <field name="flight_search_line_id"/>
                <field name="request_date"/>
                <!--                <field name="response_payload"/>-->
            </list>
        </field>
    </record>

    <record id="action_flight_api_log" model="ir.actions.act_window">
        <field name="name">Flight Logs</field>
        <field name="res_model">flight.api.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_flight_api_logs" name="Flight Logs" parent="menu_booking_conf_main" action="action_flight_api_log" sequence="10"/>
</odoo>